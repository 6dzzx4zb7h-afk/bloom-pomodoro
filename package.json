{
  "name": "bloom-pomodoro",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "description": "Bloom — a cozy pixel-pal pomodoro app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:migrations": "vitest run src/store/migrations.test.ts",
    "visual:serve": "vite --host 127.0.0.1 --port 4179 --strictPort",
    "visual:install": "playwright install chromium",
    "visual:baselines:check": "node scripts/check-visual-baselines.mjs",
    "visual:baselines:prove": "node scripts/check-visual-baselines.mjs --prove-failures",
    "visual:test": "playwright test --config playwright.visual.config.ts",
    "visual:test:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "visual:test:prove": "node scripts/prove-visual-failure.mjs",
    "visual:verify": "node scripts/check-visual-baselines.mjs && node scripts/check-visual-baselines.mjs --prove-failures && playwright test --config playwright.visual.config.ts && node scripts/prove-visual-failure.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=bloom-pomodoro",
    "icons": "node scripts/gen-icons.mjs",
    "cap:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "apk": "npm run cap:sync && node scripts/build-apk.mjs assembleDebug",
    "apk:release": "npm run cap:sync && node scripts/build-apk.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.10.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
