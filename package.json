{
  "name": "bloom-pomodoro",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "Bloom — a cozy pixel-pal pomodoro app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:migrations": "vitest run src/store/migrations.test.ts",
    "icons": "node --experimental-strip-types scripts/gen-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs assembleDebug",
    "android:key": "node scripts/android-key.mjs",
    "android:aab": "npm run android:sync && node scripts/android-build.mjs bundleRelease && node scripts/android-verify.mjs",
    "android:check": "node scripts/android-build.mjs testDebugUnitTest && node scripts/android-build.mjs lintRelease",
    "android:verify": "node scripts/android-verify.mjs",
    "android:version": "node scripts/android-version.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
