{
  "name": "bloom-pomodoro",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "Bloom — a cozy pixel-pal pomodoro app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:migrations": "vitest run src/store/migrations.test.ts",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=bloom-pomodoro",
    "icons": "node scripts/gen-icons.mjs",
    "cap:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "apk": "npm run cap:sync && node scripts/build-apk.mjs assembleDebug",
    "apk:release": "npm run cap:sync && node scripts/build-apk.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
